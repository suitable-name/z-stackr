import { Button, Palette, Switch } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { ActivityModel, ActivityItem } from "models/activity.slint";
import { AppModel } from "models/app_model.slint";
import { DialogModel } from "models/dialogs.slint";
import { FilesModel } from "models/files.slint";
import { RetouchModel } from "models/retouch.slint";
import { SettingsModel } from "models/settings.slint";
import { ShortcutsModel, ShortcutItem } from "models/shortcuts.slint";
import { ViewportModel } from "models/viewport.slint";
import { ProjectModel } from "models/project.slint";
import { ExportModel } from "models/export.slint";
import { ConfirmDialog } from "components/confirm_dialog.slint";
import { ReliefPreviewPanel } from "components/relief_preview_dialog.slint";
import { ExportDialog } from "components/export_dialog.slint";
import { Explainer, ExplainerModel } from "components/explainer.slint";
import { ImageCanvas } from "components/image_canvas.slint";
import { RetouchBar } from "components/retouch_bar.slint";
import { ToolToggle } from "components/tool_toggle.slint";
import { AboutDialog, ManualBlock, ManualDialog, ManualModel } from "components/manual_dialog.slint";
import { SettingsDialog } from "components/settings_dialog.slint";
import { ShortcutOverlay } from "components/shortcut_overlay.slint";
import { Sidebar } from "components/sidebar.slint";
import { SplitHandle } from "components/split_handle.slint";
import { StatusStrip } from "components/status_strip.slint";
import { Toast } from "components/toast.slint";

// A global is only a Rust type (`app.global::<AppModel>()`) if it is named here.
export {
    Theme,
    AppModel, SettingsModel, FilesModel, RetouchModel, DialogModel,
    ActivityModel, ActivityItem,
    ShortcutsModel, ShortcutItem,
    ViewportModel, ProjectModel,
    ExportModel, ExplainerModel, ManualModel, ManualBlock
}

// --- Sizing notes -----------------------------------------------------------
// The OS window's minimum AND maximum size are derived from its content tree's
// computed layout constraints. The whole window content therefore lives inside a
// `Rectangle` positioned with explicit `x`/`y` and `clip: true`: an explicitly
// positioned child is excluded from its parent's constraint computation, so a
// stray `min-height` deep in a child component cannot force the window bigger, and
// a layout of fixed-size children cannot cap its maximum. Content that would
// overflow clips instead of pushing the window around. Inside the wrapper, the same
// rule applies to rows and columns: never bind a layout child's size to `100%`
// (a percent binding there becomes that child's min AND max).
// -----------------------------------------------------------------------------
export component App inherits Window {
    // Titlebar / taskbar icon (winit's window class has none); generated by scripts/make-icons.py.
    icon: @image-url("../assets/icon.png");
    // ── Callbacks (handled in Rust) ───────────────────────────────────────
    callback request-open-files();
    callback file-clicked(int);
    callback result-clicked(int);
    callback undo-stroke();
    callback redo-stroke();
    callback save-current-image();
    callback remove-file(int);
    callback clear-all-files();
    callback request-stack(string, string, string);   // algo, ai-model, ai-device
    callback align-clicked();             // run alignment-only pass
    callback sort-frames();               // order the frames sharpest-first (no stack run)
    callback cull-frames();               // drop the frames that add nothing (no stack run)
    callback settings-apply();
    callback settings-cancel();
    callback settings-reset-defaults();
    callback open-settings();
    callback browse-output-dir();
    callback start-monitor();
    callback stop-monitor();
    callback load-config();
    callback save-config();
    // Emitted when the Show-Aligned switch flips so the currently-viewed image can
    // be re-rendered immediately (aligned vs. source) without re-clicking.
    callback refresh-view();
    callback relief-preview-apply();
    callback relief-preview-cancel();
    callback relief-preview-auto-detect();
    callback relief-preview-contrast-changed();
    // File > Quit. Rust asks the window to close (so a close guard sees it too).
    callback quit-app();

    // ── Window properties: each value lives in a global and is bound two-way,
    // ── so `app.set_*` and `app.global::<..>()` write the same storage. ──────
    // AI integration state, set from Rust (cfg `nn`); inert otherwise.
    in property <[string]> algo-options <=> AppModel.algo-options;
    in property <[string]> ai-model-names <=> AppModel.ai-model-names;
    in property <bool> ai-models-available <=> AppModel.ai-models-available;
    in property <bool> ai-show-device <=> AppModel.ai-show-device;
    in property <[string]> ai-device-names <=> AppModel.ai-device-names;
    // Neural alignment model picker (Settings > General); set from Rust (cfg `nn`).
    in property <[string]> align-model-names <=> AppModel.align-model-names;
    in property <bool> align-models-available <=> AppModel.align-models-available;
    in-out property <int> align-model-index <=> AppModel.align-model-index;

    // Display state
    in-out property <bool>     has-images <=> FilesModel.has-images;
    in-out property <[string]> loaded-files <=> FilesModel.loaded-files;
    in-out property <[string]> result-files <=> FilesModel.result-files;
    in-out property <image>    displayed-image <=> FilesModel.displayed-image;
    in-out property <float>    progress <=> AppModel.progress;
    in-out property <string>   status <=> AppModel.status;
    in-out property <bool>     can-undo <=> RetouchModel.can-undo;
    in-out property <bool>     can-redo <=> RetouchModel.can-redo;
    in-out property <int>      frame-count <=> AppModel.frame-count;
    in-out property <string>   elapsed-text <=> AppModel.elapsed-text;
    in-out property <float>    zoom-factor <=> AppModel.zoom-factor;
    in-out property <bool>     is-monitoring <=> AppModel.is-monitoring;
    in-out property <bool>     show-aligned <=> AppModel.show-aligned;

    // Dialog state
    in-out property <bool>  dialog-open <=> AppModel.settings-open;
    in-out property <bool>  relief-preview-open <=> AppModel.relief-preview-open;
    in-out property <image> relief-preview-image <=> AppModel.relief-preview-image;

    // True while any modal layer owns the keyboard.
    // The Relief preview is a card, not a modal layer: the shortcuts keep working
    // while it is open, so it is deliberately not part of this.
    property <bool> modal-open: AppModel.settings-open
        || DialogModel.confirm-open || ShortcutsModel.open
        || ExportModel.open || ManualModel.open || ManualModel.about-open
        || ExplainerModel.open;
    // The menu bar acts only while no modal layer is up, like the key shortcuts.
    property <bool> menu-enabled: !root.modal-open;
    // Something Export can write: a source frame or a stacked result.
    property <bool> has-output: FilesModel.has-images || FilesModel.result-files.length > 0;
    // Mirrors the card's visibility so closing it can hand the focus back.
    property <bool> relief-panel-open: AppModel.relief-preview-open;
    // There is a stacked result to retouch. The Retouch tool is offered only then.
    property <bool> can-retouch: FilesModel.result-files.length > 0;

    // The one place the Retouch tool is switched: the toolbar toggle, the `R` key,
    // the Edit menu, Esc and the options row's Done button all call this, so they
    // cannot disagree. Rust hears about a real change through `tool-toggled`.
    function set-retouch-tool(on: bool) {
        if RetouchModel.tool-on != on {
            RetouchModel.tool-on = on;
            RetouchModel.tool-toggled(on);
        }
        // The options row goes away with the tool. If its frame picker or a button
        // held the keyboard, the focus would be left on nothing and every shortcut
        // would stop working after the next change to the canvas.
        if !on {
            keys.focus();
        }
    }
    // The result went away (new project, files cleared): there is nothing to paint on.
    changed can-retouch => {
        if !root.can-retouch {
            root.set-retouch-tool(false);
        }
    }

    // ── Sidebar-split clamp. `6px` is `SplitHandle`'s fixed thickness and 480px is
    // ── the smallest canvas the split may leave. The limits come from Rust
    // ── (`settings::layout`) so the persisted clamp and this one agree. ──
    pure function sidebar-clamped(wanted: length, row-width: length) -> length {
        return clamp(
            wanted,
            ViewportModel.sidebar-min,
            max(ViewportModel.sidebar-min, min(ViewportModel.sidebar-max, row-width - 6px - 480px - 2 * Theme.space-lg))
        );
    }
    function reclamp-sidebar(row-width: length) {
        ViewportModel.sidebar-width = root.sidebar-clamped(ViewportModel.sidebar-width, row-width);
    }

    // Use preferred-* (not fixed width/height) so the window is resizable; a
    // generous default plus a sensible minimum keeps the toolbar, the Retouch
    // options row and the status strip fully visible.
    preferred-width: 1680px;
    preferred-height: 1080px;
    min-width: 1120px;
    min-height: 700px;
    title: (ProjectModel.dirty ? "* " : "") + ProjectModel.name + " \u{2013} z-stackr";
    background: Theme.bg-window;

    // The window paints its own dark theme; the std widgets (buttons, combo boxes,
    // switches, sliders) would otherwise follow the OS scheme and come out light
    // grey on a light Windows desktop.
    init => { Palette.color-scheme = ColorScheme.dark; }

    // After a modal layer closes the focused item is destroyed with it; take the
    // focus back so the keyboard shortcuts keep working without a click.
    changed modal-open => {
        if !root.modal-open {
            keys.focus();
        }
    }
    changed relief-panel-open => {
        if !root.relief-panel-open {
            keys.focus();
        }
    }

    // ── Menu bar ──────────────────────────────────────────────────────────
    // `MenuBar` must be a direct child of the window. A `MenuItem` has no
    // accelerator property, so the key shown in a title is a label only: the keys
    // themselves are handled in the root `FocusScope` below. Keep the two, and
    // `src/shortcuts_table.rs`, in step. Every item is disabled while a modal
    // layer is up, as the shortcuts are.
    MenuBar {
        Menu {
            title: "File";
            MenuItem {
                title: AppModel.web-build ? "New Project (Alt+N)" : "New Project (Ctrl+N)";
                enabled: root.menu-enabled && !AppModel.busy;
                activated => { ProjectModel.new-project(); }
            }
            MenuItem {
                title: "Open Project\u{2026} (Ctrl+Shift+O)";
                enabled: root.menu-enabled && !AppModel.busy;
                activated => { ProjectModel.open-project(); }
            }
            if !AppModel.web-build: Menu {
                title: "Open Recent";
                enabled: root.menu-enabled && !AppModel.busy && ProjectModel.recent.length > 0;
                for path[index] in ProjectModel.recent: MenuItem {
                    title: path;
                    activated => { ProjectModel.open-recent(index); }
                }
                MenuSeparator { }
                MenuItem {
                    title: "Clear Recent";
                    activated => { ProjectModel.clear-recent(); }
                }
            }
            MenuItem {
                title: "Save Project (Ctrl+S)";
                enabled: root.menu-enabled;
                activated => { ProjectModel.save-project(); }
            }
            MenuItem {
                title: "Save Project As\u{2026} (Ctrl+Shift+S)";
                enabled: root.menu-enabled;
                activated => { ProjectModel.save-project-as(); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Add Images\u{2026} (Ctrl+O)";
                enabled: root.menu-enabled;
                activated => { root.request-open-files(); }
            }
            MenuItem {
                title: "Export\u{2026} (Ctrl+E)";
                enabled: root.menu-enabled && root.has-output;
                activated => { ExportModel.request-open(); }
            }
            if !AppModel.web-build: MenuSeparator { }
            if !AppModel.web-build: MenuItem {
                title: "Quit";
                activated => { root.quit-app(); }
            }
        }
        Menu {
            title: "Edit";
            MenuItem {
                title: "Undo (Ctrl+Z)";
                enabled: root.menu-enabled && RetouchModel.can-undo;
                activated => { root.undo-stroke(); }
            }
            MenuItem {
                title: "Redo (Ctrl+Y)";
                enabled: root.menu-enabled && RetouchModel.can-redo;
                activated => { root.redo-stroke(); }
            }
            MenuSeparator { }
            MenuItem {
                title: (RetouchModel.tool-on ? "\u{2713} " : "") + "Retouch Brush (R)";
                enabled: root.menu-enabled && root.can-retouch;
                activated => { root.set-retouch-tool(!RetouchModel.tool-on); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Sort Frames by Sharpness";
                enabled: root.menu-enabled && FilesModel.has-images && !AppModel.busy && !AppModel.is-monitoring;
                activated => { root.sort-frames(); }
            }
            MenuItem {
                title: "Cull Frames";
                enabled: root.menu-enabled && FilesModel.has-images && !AppModel.busy && !AppModel.is-monitoring;
                activated => { root.cull-frames(); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Settings\u{2026} (Ctrl+,)";
                enabled: root.menu-enabled;
                activated => {
                    AppModel.settings-open = true;
                    root.open-settings();
                }
            }
        }
        Menu {
            title: "View";
            MenuItem {
                title: "Fit to Window (0)";
                enabled: root.menu-enabled;
                activated => { ViewportModel.zoom-fit(); }
            }
            MenuItem {
                title: "Actual Size, 100 % (1)";
                enabled: root.menu-enabled;
                activated => { ViewportModel.zoom-one-to-one(); }
            }
            MenuItem {
                title: "Zoom In (+)";
                enabled: root.menu-enabled;
                activated => { ViewportModel.zoom-step(1.25); }
            }
            MenuItem {
                title: "Zoom Out (-)";
                enabled: root.menu-enabled;
                activated => { ViewportModel.zoom-step(0.8); }
            }
            MenuSeparator { }
            MenuItem {
                title: (AppModel.show-aligned ? "\u{2713} " : "") + "Show Aligned";
                enabled: root.menu-enabled && FilesModel.has-images;
                activated => {
                    AppModel.show-aligned = !AppModel.show-aligned;
                    root.refresh-view();
                }
            }
        }
        Menu {
            title: "Help";
            MenuItem {
                title: "Manual (F1)";
                enabled: root.menu-enabled;
                activated => { ManualModel.open = true; }
            }
            MenuItem {
                title: "Keyboard Shortcuts (?)";
                enabled: root.menu-enabled;
                activated => { ShortcutsModel.open = true; }
            }
            MenuSeparator { }
            MenuItem {
                title: "About z-stackr";
                enabled: root.menu-enabled;
                activated => { ManualModel.about-open = true; }
            }
        }
    }

    // ── Global keyboard shortcuts (keep `models/shortcuts.slint` in step) ──
    keys := FocusScope {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        init => { self.focus(); }

        // Space arms the pan gesture (Space + left-drag). Losing focus while it is
        // held would never deliver the release, so it disarms too.
        changed has-focus => {
            if !self.has-focus {
                ViewportModel.pan-armed = false;
            }
        }
        key-released(event) => {
            if event.text == " " {
                ViewportModel.pan-armed = false;
            }
            return reject;
        }
        key-pressed(event) => {
            if event.text == Key.Escape {
                if ShortcutsModel.open {
                    ShortcutsModel.open = false;
                    return accept;
                }
                if AppModel.settings-open {
                    AppModel.settings-open = false;
                    root.settings-cancel();
                    return accept;
                }
                // The dialogs below close themselves on Esc while they hold the
                // focus; these are the fallback for a click that moved it away.
                if ExplainerModel.open {
                    ExplainerModel.open = false;
                    return accept;
                }
                if ManualModel.about-open {
                    ManualModel.about-open = false;
                    return accept;
                }
                if ManualModel.open {
                    ManualModel.open = false;
                    return accept;
                }
                if ExportModel.open {
                    ExportModel.open = false;
                    return accept;
                }
                // Leaving the Retouch tool comes before a toast: the tool is what the
                // user is in, a toast (such as "Finished!") only happens to be up.
                if RetouchModel.tool-on {
                    root.set-retouch-tool(false);
                    return accept;
                }
                if DialogModel.toast-visible {
                    DialogModel.toast-visible = false;
                    DialogModel.toast-dismissed();
                    return accept;
                }
                return reject;
            }
            if root.modal-open {
                return reject;
            }
            if event.text == Key.F1 {
                ManualModel.open = true;
                return accept;
            }
            // Shift-modified letters arrive upper-case ("S", "O"), so the plain
            // branches below need no `!shift` test of their own.
            if (event.modifiers.control || event.modifiers.meta) && event.modifiers.shift && event.text == "S" {
                ProjectModel.save-project-as();
                return accept;
            }
            if (event.modifiers.control || event.modifiers.meta) && event.modifiers.shift && event.text == "O" {
                if !AppModel.busy {
                    ProjectModel.open-project();
                }
                return accept;
            }
            if (event.modifiers.control || event.modifiers.meta) && event.text == "n" {
                if !AppModel.busy {
                    ProjectModel.new-project();
                }
                return accept;
            }
            // The browser keeps Ctrl+N for itself, so the web build also takes Alt+N.
            if AppModel.web-build && event.modifiers.alt && !event.modifiers.control && !event.modifiers.meta && event.text.to-lowercase() == "n" {
                if !AppModel.busy {
                    ProjectModel.new-project();
                }
                return accept;
            }
            if (event.modifiers.control || event.modifiers.meta) && event.text == "e" {
                if root.has-output {
                    ExportModel.request-open();
                }
                return accept;
            }
            if (event.modifiers.control || event.modifiers.meta) && event.text == "o" {
                root.request-open-files();
                return accept;
            }
            if (event.modifiers.control || event.modifiers.meta) && event.text == "s" {
                ProjectModel.save-project();
                return accept;
            }
            if (event.modifiers.control || event.modifiers.meta) && event.text == "," {
                AppModel.settings-open = true;
                root.open-settings();
                return accept;
            }
            if (event.modifiers.control || event.modifiers.meta) && !event.modifiers.shift && event.text == "z" {
                if RetouchModel.can-undo {
                    root.undo-stroke();
                }
                return accept;
            }
            if (event.modifiers.control || event.modifiers.meta) && (event.text == "y" || (event.modifiers.shift && event.text == "Z")) {
                if RetouchModel.can-redo {
                    root.redo-stroke();
                }
                return accept;
            }
            if !event.modifiers.control && !event.modifiers.meta && !event.modifiers.alt {
                if event.text == "?" {
                    ShortcutsModel.open = true;
                    return accept;
                }
                if event.text == " " {
                    ViewportModel.pan-armed = true;
                    return accept;
                }
                if event.text == "+" || event.text == "=" {
                    ViewportModel.zoom-step(1.25);
                    return accept;
                }
                if event.text == "-" {
                    ViewportModel.zoom-step(0.8);
                    return accept;
                }
                if event.text == "0" {
                    ViewportModel.zoom-fit();
                    return accept;
                }
                if event.text == "1" {
                    ViewportModel.zoom-one-to-one();
                    return accept;
                }
                if event.text == "r" || event.text == "R" {
                    if root.can-retouch {
                        root.set-retouch-tool(!RetouchModel.tool-on);
                    }
                    return accept;
                }
                // Brush size steps, while the tool is on: a fifth of the size, at least 1 px.
                if RetouchModel.tool-on && event.text == "[" {
                    RetouchModel.brush-size = max(1.0, RetouchModel.brush-size - max(1.0, RetouchModel.brush-size * 0.2));
                    return accept;
                }
                if RetouchModel.tool-on && event.text == "]" {
                    RetouchModel.brush-size = min(100.0, RetouchModel.brush-size + max(1.0, RetouchModel.brush-size * 0.2));
                    return accept;
                }
            }
            return reject;
        }

        // All window content, clipped inside an explicitly positioned wrapper (see
        // the sizing notes above).
        Rectangle {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            clip: true;

            VerticalLayout {
                // ── Top toolbar ───────────────────────────────────────────
                Rectangle {
                    height: Theme.toolbar-height;
                    background: Theme.bg-toolbar;

                    HorizontalLayout {
                        padding-left: Theme.space-lg;
                        padding-right: Theme.space-lg;
                        padding-top: Theme.space-sm;
                        padding-bottom: Theme.space-sm;
                        spacing: Theme.space-sm;
                        alignment: start;

                        Button {
                            text: "Open Files";
                            height: Theme.control-height;
                            clicked => { root.request-open-files(); }
                        }

                        Button {
                            text: "Settings";
                            height: Theme.control-height;
                            clicked => {
                                AppModel.settings-open = true;
                                root.open-settings();
                            }
                        }

                        Rectangle { width: Theme.space-sm; }

                        Button {
                            text: "Start Stacking";
                            primary: true;
                            height: Theme.control-height;
                            enabled: FilesModel.has-images && !AppModel.is-monitoring && !AppModel.busy;
                            clicked => { root.request-stack(sidebar.algo-value, sidebar.ai-model-value, sidebar.ai-device-value); }
                        }

                        if !AppModel.web-build: Button {
                            text: AppModel.is-monitoring ? "Stop Monitor" : "Live Monitor";
                            height: Theme.control-height;
                            // Stopping must stay possible while the monitor itself is the
                            // running activity.
                            enabled: AppModel.is-monitoring || !AppModel.busy;
                            clicked => {
                                if (AppModel.is-monitoring) {
                                    root.stop-monitor();
                                } else {
                                    root.start-monitor();
                                }
                            }
                        }

                        Rectangle { width: Theme.space-sm; }

                        Button {
                            text: "Align";
                            height: Theme.control-height;
                            enabled: FilesModel.has-images && !AppModel.is-monitoring && !AppModel.busy;
                            clicked => { root.align-clicked(); }
                        }

                        HorizontalLayout {
                            spacing: Theme.space-xs + 2px;
                            alignment: center;
                            Text { text: "Show Aligned"; color: Theme.text-primary; font-size: Theme.font-md; vertical-alignment: center; }
                            Switch { accessible-label: "Show Aligned"; checked <=> AppModel.show-aligned; toggled => { root.refresh-view(); } }
                        }

                        Rectangle { width: Theme.space-sm; }

                        // The Retouch tool: lit while on. It needs a stacked result.
                        ToolToggle {
                            text: "Retouch";
                            checked: RetouchModel.tool-on;
                            enabled: root.can-retouch;
                            tip: root.can-retouch
                                ? "Paint pixels from one source frame onto the result (R). Press Esc or Done to leave the tool; with it off, a left-drag pans the image."
                                : "Stack the images first: there is no result to retouch yet.";
                            clicked => { root.set-retouch-tool(!RetouchModel.tool-on); }
                        }

                        Rectangle { horizontal-stretch: 1; }

                        Button {
                            text: "Export\u{2026}";
                            height: Theme.control-height;
                            enabled: root.has-output;
                            clicked => { ExportModel.request-open(); }
                        }

                        Button {
                            text: "?";
                            height: Theme.control-height;
                            clicked => { ShortcutsModel.open = true; }
                        }
                    }

                    // Bottom separator line
                    Rectangle {
                        y: parent.height - Theme.hairline;
                        height: Theme.hairline;
                        background: Theme.border-toolbar;
                    }
                }

                // ── Main content row ──────────────────────────────────────
                HorizontalLayout {
                    vertical-stretch: 1;

                    // The persisted sidebar width is re-clamped against THIS row's real
                    // width, so a width saved on a big monitor cannot starve the canvas
                    // on a small one. A clamp here never fires `layout-changed`: only a
                    // user drag is a layout choice worth remembering.
                    init => { root.reclamp-sidebar(self.width); }
                    changed width => { root.reclamp-sidebar(self.width); }

                    sidebar := Sidebar {
                        width: ViewportModel.sidebar-width;
                        loaded-files: FilesModel.loaded-files;
                        result-files: FilesModel.result-files;
                        algo-options: AppModel.algo-options;
                        ai-model-names: AppModel.ai-model-names;
                        ai-models-available: AppModel.ai-models-available;
                        ai-show-device: AppModel.ai-show-device;
                        ai-device-names: AppModel.ai-device-names;
                        file-clicked(idx)   => { root.file-clicked(idx); }
                        result-clicked(idx) => { root.result-clicked(idx); }
                        remove-file(idx)    => { root.remove-file(idx); }
                        clear-all-files     => { root.clear-all-files(); }
                        sort-frames         => { root.sort-frames(); }
                        cull-frames         => { root.cull-frames(); }
                    }

                    // ── Sidebar | canvas split ─────────────────────────────
                    SplitHandle {
                        dragged(d) => {
                            ViewportModel.sidebar-width = root.sidebar-clamped(ViewportModel.sidebar-width + d, parent.width);
                            ViewportModel.layout-changed();
                        }
                    }

                    VerticalLayout {
                        padding: Theme.space-lg;
                        spacing: Theme.space-md;

                        // ── Retouch options: only while the tool is on ─────
                        if RetouchModel.tool-on: RetouchBar {
                            undo-stroke => { root.undo-stroke(); }
                            redo-stroke => { root.redo-stroke(); }
                            done => { root.set-retouch-tool(false); }
                        }

                        // ── Canvas ─────────────────────────────────────────
                        ImageCanvas {
                            has-images: FilesModel.has-images;
                            displayed-image: FilesModel.displayed-image;
                            retouch-on: RetouchModel.tool-on;
                            brush-size: RetouchModel.brush-size;
                            request-open-files => { root.request-open-files(); }
                            pressed => { keys.focus(); }
                        }

                        // ── Zoom controls ───────────────────────────────────
                        HorizontalLayout {
                            spacing: Theme.space-sm;
                            alignment: center;
                            height: Theme.control-height;
                            Button { text: "Fit";  height: Theme.control-height-sm; width: 48px; clicked => { ViewportModel.zoom-fit(); } }
                            Button { text: "100%"; height: Theme.control-height-sm; width: 52px; clicked => { ViewportModel.zoom-one-to-one(); } }
                            Button { text: "-";    height: Theme.control-height-sm; width: Theme.control-height-sm; clicked => { ViewportModel.zoom-step(0.8); } }
                            Text {
                                text: Math.round(AppModel.zoom-factor * 100) + "%";
                                color: Theme.text-secondary;
                                font-size: Theme.font-md;
                                vertical-alignment: center;
                                width: 44px;
                                horizontal-alignment: center;
                            }
                            Button { text: "+"; height: Theme.control-height-sm; width: Theme.control-height-sm; clicked => { ViewportModel.zoom-step(1.25); } }
                        }
                    }
                }

                // ── Status strip (status text, progress, activities) ──────
                StatusStrip { }
            }

            // ── Settings dialog overlay ───────────────────────────────────
            if (AppModel.settings-open) : SettingsDialog {
                apply() => {
                    AppModel.settings-open = false;
                    root.settings-apply();
                }
                cancel() => {
                    AppModel.settings-open = false;
                    root.settings-cancel();
                }
                reset-defaults() => { root.settings-reset-defaults(); }
                browse-output-dir() => { root.browse-output-dir(); }
                load-config() => { root.load-config(); }
                save-config() => { root.save-config(); }
            }

            // The depth-map preview: a card over the canvas's top-right corner, not
            // a modal dialog (no backdrop; the rest of the window stays usable).
            if (AppModel.relief-preview-open) : ReliefPreviewPanel {
                z: 100;
                x: parent.width - self.width - Theme.space-lg;
                y: Theme.toolbar-height + Theme.space-lg;
                contrast-pct <=> SettingsModel.relief-contrast-pct;
                preview-image: AppModel.relief-preview-image;
                apply => { root.relief-preview-apply(); }
                cancel => { root.relief-preview-cancel(); }
                auto-detect => { root.relief-preview-auto-detect(); }
                contrast-changed => { root.relief-preview-contrast-changed(); }
            }

            // ── Export dialog (File > Export…) ────────────────────────────
            if ExportModel.open : ExportDialog {
                width: 100%;
                height: 100%;
                z: 410;
                close => { ExportModel.open = false; }
                save => {
                    ExportModel.open = false;
                    ExportModel.save();
                }
                // Save As…: a save dialog asks for the name, whatever the output
                // folder setting says.
                save-as => {
                    ExportModel.open = false;
                    root.save-current-image();
                }
                change-directory => { root.browse-output-dir(); }
            }

            // ── Manual and About (Help menu) ──────────────────────────────
            if ManualModel.open : ManualDialog {
                width: 100%;
                height: 100%;
                z: 420;
            }
            if ManualModel.about-open : AboutDialog {
                width: 100%;
                height: 100%;
                z: 430;
            }

            // ── First-use explainer ("Don't show again") ──────────────────
            if ExplainerModel.open : Explainer {
                width: 100%;
                height: 100%;
                z: 440;
                dismiss(dont-show-again) => {
                    ExplainerModel.open = false;
                    ExplainerModel.dismissed(ExplainerModel.key, dont-show-again);
                }
            }

            // ── Keyboard shortcut overlay ─────────────────────────────────
            if ShortcutsModel.open : ShortcutOverlay {
                width: 100%;
                height: 100%;
                z: 400;
            }

            // ── Confirmation dialog (closed by default) ───────────────────
            if DialogModel.confirm-open : ConfirmDialog {
                width: 100%;
                height: 100%;
                z: 500;
                heading: DialogModel.confirm-heading;
                message: DialogModel.confirm-message;
                primary-label: DialogModel.confirm-primary-label;
                secondary-label: DialogModel.confirm-secondary-label;
                tertiary-label: DialogModel.confirm-tertiary-label;
                primary => {
                    DialogModel.confirm-open = false;
                    DialogModel.confirm-primary(DialogModel.confirm-action);
                }
                secondary => {
                    DialogModel.confirm-open = false;
                    DialogModel.confirm-secondary(DialogModel.confirm-action);
                }
                tertiary => {
                    DialogModel.confirm-open = false;
                    DialogModel.confirm-tertiary(DialogModel.confirm-action);
                }
                cancel => {
                    DialogModel.confirm-open = false;
                    DialogModel.confirm-cancel(DialogModel.confirm-action);
                }
            }

            // ── Toast (closed by default) ─────────────────────────────────
            if DialogModel.toast-visible : Toast {
                z: 600;
                width: min(380px, parent.width - 2 * Theme.space-lg);
                x: (parent.width - self.width) / 2;
                // Float above the status strip and the zoom row (the column's bottom
                // padding plus the row), so a sticky error never covers the status
                // line it points at or the Fit / 100% / zoom buttons. While a modal
                // dialog is open the toast moves to the top edge instead, where only
                // the backdrop is: at the bottom it covered the dialog's Cancel and
                // Apply buttons (found by the UI harness).
                y: AppModel.settings-open || ExportModel.open || ManualModel.open
                    || ManualModel.about-open || ExplainerModel.open || ShortcutsModel.open
                    || DialogModel.confirm-open
                    ? Theme.space-lg
                    : parent.height - self.height - Theme.statusbar-height - Theme.space-lg - Theme.control-height - Theme.space-xl;
                text: DialogModel.toast-text;
                toast-type: DialogModel.toast-kind;
                dismiss => {
                    DialogModel.toast-visible = false;
                    DialogModel.toast-dismissed();
                }
            }
        }
    }
}
