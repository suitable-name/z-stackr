{
	// z-stackr build tasks for VS Code. Install: copy this file to .vscode/tasks.json
	// (see docs/build-tasks.md). It is JSON with comments, which VS Code accepts.
	//
	// Build matrix: {GUI, CLI, Trainer} x {generic, x86-64-v3, x86-64-v4, znver3, znver4} x {Windows, Linux},
	// then the PGO chains (and BOLT, Linux only) for the CLI and the GUI at the bottom.
	//
	// CPU variants are driven by RUSTFLAGS (-C target-cpu=...). The SIMD lane count is fixed when the
	// code is compiled, so a wider variant is faster but only runs on CPUs that have the features:
	//   generic    -> baseline x86-64 (SSE2, 4 SIMD lanes)
	//   x86-64-v3  -> AVX2 + FMA + BMI (Haswell / Zen 1 and newer), 8 lanes
	//   x86-64-v4  -> AVX-512 F/BW/CD/DQ/VL, 16 lanes
	//   znver3     -> AMD Zen 3 tuned (AVX2 + FMA)
	//   znver4     -> AMD Zen 4 tuned (AVX-512)
	//
	// Each variant has its own CARGO_TARGET_DIR (target/<variant>), so switching variants never
	// invalidates another variant's build cache.
	//
	// OS variants use explicit --target triples. Cross-compiling needs the target installed
	// (rustup target add x86_64-unknown-linux-gnu / x86_64-pc-windows-msvc) and a matching linker;
	// the GUI (Slint / winit) generally only builds for the host OS, so run the matching task on
	// the matching machine (this file is shared between them).
	//
	// Features are not set here. To add some, append e.g. `--features akaze,raw,gpu` to a command
	// (CLI/GUI: akaze, raw, gpu, nn, nn-gpu; the GUI has akaze on by default).
	//
	// The project needs a NIGHTLY toolchain (portable_simd); rust-toolchain.toml pins it.
	"version": "2.0.0",
	"tasks": [
		// ---- GUI (desktop app, binary `z-stackr-gui`) - Windows ----
		{
			"type": "shell",
			"label": "build GUI release - generic (Windows)",
			"command": "cargo build --release -p z-stackr-gui --target x86_64-pc-windows-msvc",
			"options": {
				"env": {
					"CARGO_TARGET_DIR": "target/generic"
				}
			},
			"problemMatcher": ["$rustc"],
			"group": "build"
		},
		{
			"type": "shell",
			"label": "build GUI release - x86-64-v3 (Windows)",
