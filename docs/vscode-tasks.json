		// ====================================================================================
		// PGO (profile-guided optimisation) chains, plus BOLT on Linux.
		//
		// Prerequisites:
		//   * `rustup component add llvm-tools` and put its bin directory on PATH
		//     (<sysroot>/lib/rustlib/<host>/bin), or a system LLVM, so that `llvm-profdata` is
		//     available. Its LLVM major version must match rustc's (`rustc -vV`).
		//   * BOLT (Linux ONLY: it rewrites ELF, the Windows PE format is not supported): the
		//     `llvm-bolt` binary from LLVM's bolt package, same major version.
		//   * Every step uses the `release-perf` cargo profile (release code, line tables and
		//     symbols kept; see the root Cargo.toml) and the dedicated target directory
		//     `target/pgo`, so the normal build caches stay untouched.
		//   * Both cargo phases of one chain must run the SAME cargo command (same -p, same
		//     --features, same --target), only the RUSTFLAGS differ. Anything else changes the
		//     crate hashes in the symbol names and LLVM silently skips every function of the
		//     profile. The optimised build passes -pgo-warn-missing-function, so a mismatch
		//     shows up as a flood of `no profile data available for function` warnings for
		//     z-stackr functions in step 4's output. Do not ship a build that printed them.
		//   * Do not edit the sources between step 1 and step 4.
		//
		// Run the numbered steps in order. Step 2 trains on the 28 frames in sample/ with
		// scripts/pgo-workload.sh (Linux) or scripts/pgo-workload.ps1 (Windows): Apex, Relief,
		// Relief with the multigrid solver and Strata, aligned with registration + Lucas-Kanade,
		// registration + Nelder-Mead and the six-parameter affine model. The GUI workload is
		// interactive: the task launches the instrumented binary; load a stack, align it, fuse
		// it with Apex, Relief and Strata, then quit (profiles are written on exit).
		//
		// The CPU in the chain (znver4 on Linux, znver3 on Windows) is an example: replace the
		// `target-cpu` in all steps of a chain, and the directory names, to match your machine.
		// ====================================================================================

		// ---- PGO + BOLT: CLI - znver4 (Linux) ----
		{
			"type": "shell",
			"label": "PGO CLI znver4 Linux - 1: build instrumented",
			"command": "cargo build --profile release-perf -p z-stackr-cli --target x86_64-unknown-linux-gnu",
			"options": {
				"env": {
					"RUSTFLAGS": "-C target-cpu=znver4 -C profile-generate=${workspaceFolder}/target/pgo-data/cli-znver4",
					"CARGO_TARGET_DIR": "target/pgo"
				}
			},
			"problemMatcher": ["$rustc"],
			"group": "build"
		},
		{
			"type": "shell",
			"label": "PGO CLI znver4 Linux - 2: run workload (apex, relief, multigrid, strata; registration LK/NM, affine)",
			"command": "bash scripts/pgo-workload.sh target/pgo/x86_64-unknown-linux-gnu/release-perf/z-stackr",
			"problemMatcher": [],
			"group": "build"
		},
		{
			"type": "shell",
			"label": "PGO CLI znver4 Linux - 3: merge profiles",
			"command": "llvm-profdata merge -o target/pgo-data/cli-znver4/merged.profdata target/pgo-data/cli-znver4",
			"problemMatcher": [],
			"group": "build"
		},
		{
			"type": "shell",
			"label": "PGO CLI znver4 Linux - 4: build PGO-optimised (BOLT-ready)",
			"command": "cargo build --profile release-perf -p z-stackr-cli --target x86_64-unknown-linux-gnu",
			"options": {
				"env": {
					"RUSTFLAGS": "-C target-cpu=znver4 -C profile-use=${workspaceFolder}/target/pgo-data/cli-znver4/merged.profdata -C llvm-args=-pgo-warn-missing-function -C link-args=-Wl,--emit-relocs",
					"CARGO_TARGET_DIR": "target/pgo"
				}
			},
			"problemMatcher": ["$rustc"],
			"group": "build"
		},
		{
			"type": "shell",
			"label": "BOLT CLI znver4 Linux - 5: instrument",
			"command": "llvm-bolt target/pgo/x86_64-unknown-linux-gnu/release-perf/z-stackr -instrument -o target/pgo/x86_64-unknown-linux-gnu/release-perf/z-stackr-inst --instrumentation-file=${workspaceFolder}/target/pgo-data/cli-znver4-bolt.fdata",
			"problemMatcher": [],
			"group": "build"
		},
		{
			"type": "shell",
			"label": "BOLT CLI znver4 Linux - 6: run instrumented workload",
			"command": "bash scripts/pgo-workload.sh target/pgo/x86_64-unknown-linux-gnu/release-perf/z-stackr-inst",
			"problemMatcher": [],
			"group": "build"
		},
		{
			"type": "shell",
			"label": "BOLT CLI znver4 Linux - 7: optimise layout (-> z-stackr-bolt)",
			"command": "llvm-bolt target/pgo/x86_64-unknown-linux-gnu/release-perf/z-stackr -o target/pgo/x86_64-unknown-linux-gnu/release-perf/z-stackr-bolt --data=target/pgo-data/cli-znver4-bolt.fdata -reorder-blocks=ext-tsp -reorder-functions=hfsort -split-functions -split-all-cold -icf=1 -dyno-stats",
			"problemMatcher": [],
			"group": "build"
		},
